{
  "name": "buzzword-techtionary",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test server/test/*.test.js",
    "test:client": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^10.2.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
